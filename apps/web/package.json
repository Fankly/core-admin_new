    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vite-plugin-lazy-import": "^1.0.7",
    "vite-plugin-svg-icons-ng": "^1.10.0",
    "vite-plugin-vue-devtools": "^8.2.1",
