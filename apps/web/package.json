{
  "name": "budget-process",
  "version": "1.00.052",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "mock": "vite --mode mock",
    "preview": "vite preview",
    "build": "pnpm run build:prod",
    "build:prod": "vite build --mode production --logLevel warn",
    "build:sit": "vite build --mode production.sit",
    "build:uat": "vite build --mode production.uat",
    "serve": "pnpm run build && vite preview",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:fast": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{vue,ts}\" --fix",
    "lint:check": "eslint \"src/**/*.{vue,ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{vue,ts,scss,less}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
