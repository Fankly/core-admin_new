    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@visactor/vue-vtable": "^1.26.8",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "@vxe-ui/core": "^4.4.29",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "decimal.js": "^10.6.0",
    "driver.js": "^1.9.0",
    "echarts": "^6.1.0",
    "echarts-gl": "^2.1.0",
    "element-plus": "^2.14.7",
    "exceljs": "^4.4.0",
    "js-base64": "^3.9.4",
    "lodash": "^4.18.1",
    "markdown-it": "^15.0.2",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "qs": "^6.16.0",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^5.4.0",
