{
  "name": "core-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter budget-process dev",
    "build": "pnpm --filter budget-process build",
    "build:sit": "pnpm --filter budget-process build:sit",
    "build:uat": "pnpm --filter budget-process build:uat",
    "preview": "pnpm --filter budget-process preview",
    "serve": "pnpm --filter budget-process serve",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "format": "prettier --write \"**/*.{vue,ts,tsx,js,mjs,scss,less,json,md}\" --ignore-path .gitignore",
    "test": "pnpm -r --parallel test",
    "e2e": "pnpm --filter budget-process e2e",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:"
  }
}
